# ClickHouse / Kafka endpoints (internal or managed services)
CLICKHOUSE_HTTP_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=ctp
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TICK_TOPIC=ctp_ticks
