# CTP Trading Configuration
CTP_BROKER_ID=your_broker_id
CTP_USER_ID=your_user_id
CTP_PASSWORD=your_password
CTP_MD_SERVER=tcp://your_md_server:port
CTP_TRADE_SERVER=tcp://your_trade_server:port
CTP_APP_ID=your_app_id
CTP_AUTH_CODE=your_auth_code
CTP_REQUIRE_AUTH=false

# LangSmith Tracing Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=ringshell

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Firecrawl Configuration
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Redis Configuration
RINGSHELL_REDIS_HOST=your_redis_host
RINGSHELL_REDIS_PORT=your_redis_port
RINGSHELL_REDIS_USERNAME=your_redis_username
RINGSHELL_REDIS_PASSWORD=your_redis_password